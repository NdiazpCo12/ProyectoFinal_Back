{
  "name": "worker-node",
  "version": "0.1.0",
  "description": "Language worker to execute Node.js submissions from the queue",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "start": "node dist/main.js",
    "start:dev": "ts-node --project tsconfig.json src/main.ts",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "bullmq": "^4.15.0",
    "dotenv": "^16.4.5",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "@types/node": "^20.12.11",
    "@types/pg": "^8.11.4",
    "rimraf": "^5.0.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  }
}
