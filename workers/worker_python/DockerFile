FROM node:20-bullseye

WORKDIR /app

# Install Python runtime for executing submissions
RUN apt-get update \
  && apt-get install -y --no-install-recommends python3 python3-venv python3-pip time \
  && rm -rf /var/lib/apt/lists/*

COPY package.json package-lock.json* tsconfig.json ./

RUN npm install

COPY src ./src

RUN npm run build

CMD ["node", "dist/main.js"]
